      "AI Trainer",
      "Today's Training",
      "Progress",
      "Programs",
      "Master",
      "Library"
    ]
  },
  "ai_trainer": {
    "name": "X",
    "capabilities": [
      "explain workouts",
      "use owned-program context",
      "organize routines",
      "summarize progress",
      "adapt general suggestions to time/equipment/preferences"
    ],
    "tools": [
      "get_user_profile",
      "get_entitlements",
      "get_current_program",
      "get_today_mission",
      "get_workout_history",
      "get_progress_summary",
      "search_library",
      "get_upcoming_events"
    ],
    "safety": [
      "no diagnosis",
      "no medication instructions",
      "no injury diagnosis",
      "redirect pain/injury symptoms to qualified professionals"
    ]
  },
  "wkt": {
    "role": "first paid program",
    "unique_workouts": 21,
    "schedule": "12 weeks, Monday-Friday",
    "full_video_provider": "google-drive-preview",
    "public_teasers": "5-15 second muted loops only"
  },
  "security": {
    "rls": "required on every exposed table",
    "client_key": "Supabase publishable key only",
    "server_secrets": [
      "SUPABASE_SECRET_KEY",
      "XPAYMENTS_API_KEY",
      "OPENAI_API_KEY"
    ],
    "authorization": "verified auth identity + server checks + RLS + entitlements"
  },
  "payments": {
    "provider": "XPayments",
    "currency": "BRL",
    "method": "pix",
    "wkt_price_cents": 6700,
    "final_state": "payment_intent.succeeded + succeeded",
    "preview_mode": "mock"
  },
  "phases": [
    "Supabase foundation + MyTrainX brand shell",
    "Command Center",
    "WKT as program",
    "AI Trainer MVP",
    "Master + Library + Community + Events",
    "WhatsApp channel"
  ]
